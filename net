#!/bin/zsh
set -euo pipefail

tool_dir="${0:A:h}"
binary="$tool_dir/.build/release/net-switch"

if [[ ! -x "$binary" || "$tool_dir/Package.swift" -nt "$binary" || -n "$(find "$tool_dir/Sources" -type f -newer "$binary" -print -quit)" ]]; then
  echo "正在构建最新版本的网络切换助手..."
  (cd "$tool_dir" && swift build -c release)
fi

exec "$binary" "$@"
